{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonder",
  "version": "0.1.0",
  "identifier": "net.sonder.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Sonder",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Live data, played as music",
    "longDescription": "Sonder is a realtime generative music engine that listens to the world: live public data streams (traffic cameras, earthquakes, Wikipedia, markets, the solar wind) become an evolving piece of music.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["libasound2t64 | libasound2"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
